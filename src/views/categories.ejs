<%- include('partials/header', { title: title }) %>

    <main class="container">

        <h1>
            <%= title %>
        </h1>

        <section class="categories">

            <% categories.forEach(category=> { %>

                <div class="category-card">

                    <h2>
                        <%= category.name %>
                    </h2>

                </div>

                <% }) %>

        </section>

    </main>

    <%- include('partials/footer') %>